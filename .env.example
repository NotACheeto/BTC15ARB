# Trading Modes (LIVE_TRADING MUST REMAIN false UNTIL MANUALLY ENABLED)
LIVE_TRADING=false
PAPER_TRADING=true
DATA_MODE=false

# Risk & Capital Controls
MAX_CONTRACTS_PER_LEG=1
MAX_CONCURRENT_ARBITRAGES=1
MAX_UNHEDGED_POSITION=1
MIN_NET_EDGE=0.02
MAX_MARKET_DATA_AGE_MS=1500
MAX_ORPHAN_EXIT_LOSS=0.02
EXECUTION_TIMEOUT_MS=2000
ORDER_CANCEL_TIMEOUT_MS=1000
LATENCY_BUFFER_MODE=p95
LATENCY_PERCENTILE=95.0

DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050
DB_PATH=btc_arbitrage.db

# Polymarket US Credentials (polymarket.us)
# Generated from https://polymarket.us/developer
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=
POLYMARKET_US_GATEWAY_URL=https://gateway.polymarket.us
POLYMARKET_US_API_URL=https://api.polymarket.us
POLYMARKET_US_WS_URL=wss://api.polymarket.us

# Kalshi Credentials (kalshi.com)
# Generated under Account & Security -> API Keys
KALSHI_API_KEY_ID=
# Provide either KALSHI_PRIVATE_KEY_PATH (file path) or KALSHI_PRIVATE_KEY_PEM (raw PEM string)
KALSHI_PRIVATE_KEY_PATH=
KALSHI_PRIVATE_KEY_PEM=
KALSHI_API_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_ELECTIONS_API_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2
